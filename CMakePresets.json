{
	"version": 11,
	"cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": {
				"CMAKE_SYSTEM_NAME": "Windows",
				"CMAKE_SYSTEM_VERSION": "10.0.19045.0",
				"VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
				"VCPKG_HOST_TRIPLET": "x64-windows-static-md",
				"CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
			}
		},
		{
			"name": "ninja-release",
			"displayName": "Ninja Release (RelWithDebInfo, MSVC cl.exe from a VS developer prompt)",
			"inherits": "base",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/ninja-release",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
		},
		{
			"name": "ninja-debug",
			"displayName": "Ninja Debug",
			"inherits": "base",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/ninja-debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL"
			}
		},
		{
			"name": "vs2026",
			"displayName": "Visual Studio 2026 (multi-config, open build/vs2026/F4MP.sln)",
			"inherits": "base",
			"generator": "Visual Studio 18 2026",
			"architecture": { "value": "x64", "strategy": "set" },
			"binaryDir": "${sourceDir}/build/vs2026"
		}
	],
	"buildPresets": [
		{ "name": "ninja-release", "configurePreset": "ninja-release" },
		{ "name": "ninja-debug", "configurePreset": "ninja-debug" },
		{ "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "RelWithDebInfo" },
		{ "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" }
	]
}
